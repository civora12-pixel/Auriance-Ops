{
  "name": "auriance-ops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build && tsup",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "seed": "tsx server/scripts/seed.ts",
    "smoke": "tsx server/scripts/smoke.ts",
    "db:generate": "drizzle-kit generate",
    "prettier-fix": "prettier --write .",
    "prettier-check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hookform/resolvers": "^5.5.7",
    "@tanstack/react-query": "^5.101.4",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.13",
    "i18next": "^26.4.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "4.10.38",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.15",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "read-excel-file": "5.8.8",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "vaul": "^1.1.2",
    "write-excel-file": "4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  }
}
