# Copy to .env for local development (the server loads it when present), or set these as
# service variables on Railway. Everything is optional except where noted.

# --- First admin account (recommended in production) ---
# Created on start when the database has no users. Without these, the first
# person to open the app gets the setup screen, so set them before you deploy.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME=Owner

# --- Business defaults (admins can change them later in Settings) ---
APP_NAME=Auriance Ops
# ISO 4217 code, e.g. EGP, EUR, GBP
APP_CURRENCY=EGP
# number and date format, e.g. en-GB, ar-EG
APP_LOCALE=en-US
# IANA zone that defines "today", e.g. Africa/Cairo
APP_TIMEZONE=Africa/Cairo

# --- Storage ---
# The Docker image already uses /data/app.db and /data/backups (mount a volume at /data).
DATABASE_PATH=./data/app.db
BACKUP_DIR=./data/backups
# nightly backups kept
BACKUP_KEEP=7

# --- Server ---
PORT=3000
# Public URL. On Railway this is derived from RAILWAY_PUBLIC_DOMAIN automatically.
# APP_ORIGIN=https://ops.example.com

# Fill an empty database with demo data on start (needs an admin to exist)
SEED_DEMO=false
